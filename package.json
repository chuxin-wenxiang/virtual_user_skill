{
  "name": "virtual-user-skill",
  "version": "2.0.0",
  "description": "AI User Research System - 5 working modes covering the full product lifecycle. Based on 140,000+ real user interview records.",
  "main": "src/main.py",
  "scripts": {
    "start": "python src/main.py",
    "explore": "python src/main.py --mode explore",
    "debate": "python src/main.py --mode debate",
    "pmf": "python src/main.py --mode pmf",
    "prd": "python src/main.py --mode prd",
    "metrics": "python src/main.py --mode metrics",
    "init": "python src/encrypt.py",
    "prepare-data": "python scripts/prepare_data.py",
    "test": "python -m pytest tests/"
  },
  "keywords": [
    "virtual-user",
    "user-research",
    "pmf-validation",
    "product-market-fit",
    "user-interview",
    "prd-calibration",
    "metrics-voting",
    "ai-research",
    "scenario-library",
    "product-testing"
  ],
  "author": "Fliggy UXR Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chuxin-wenxiang/virtual_user_skill.git"
  },
  "dependencies": {
    "python": ">=3.8",
    "sentence-transformers": ">=2.2.0",
    "numpy": ">=1.21.0",
    "scikit-learn": ">=1.0.0",
    "cryptography": ">=3.4.0",
    "pandas": ">=1.3.0"
  }
}
